DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Old *Controller.php URLs are mapped to api.php.
    RewriteRule ^entriesController\.php$ api.php?module=entries [QSA,L]
    RewriteRule ^productsController\.php$ api.php?module=products [QSA,L]
    RewriteRule ^galleryController\.php$ api.php?module=gallery [QSA,L]
    RewriteRule ^settingsController\.php$ api.php?module=settings [QSA,L]
    RewriteRule ^fenceStylesController\.php$ api.php?module=fenceStyles [QSA,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # A deleted asset must 404: the fallback below boots the admin app, whose login redirect made
    # old image URLs "ask to log in" — and minted an admin session cookie for every probing bot.
    RewriteRule ^assets/ - [R=404,L]

    RewriteRule ^ index.php [L]
</IfModule>
