Options -Indexes

# Never run uploaded files as PHP. The rewrite shows the app's 404 page; the Require
# fallback is for servers without mod_rewrite (both on would always give a 403).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} \.(?i:php|phtml|php3|php4|php5|phar)$
    RewriteRule ^ ../../../index.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
    <FilesMatch "\.(?i:php|phtml|php3|php4|php5|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "script-src 'none'; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
