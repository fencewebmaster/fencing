.claude
CLAUDE.md

config.php
config.php.lock
config.php.bak.php
config.php.tmp.*.php
writable/wc-products-*-downloading.csv
writable/wc-products-*.csv.backup
writable/.wc-products-*-job.json
writable/.wc-products-*.lock
writable/wc-products-*
writable/products*
writable/missing-products*
writable/groups-permissions/*.json
writable/theme.json
writable/fences/*.php
# Writers stage a temp file beside the target and rename it in; an interrupted save or CSV import leaves it behind.
writable/theme.json.tmp.*
writable/groups-permissions/*.json.tmp.*
writable/.products-import-*.csv
writable/.wc-products-*-import-*.csv
# Changelogs data (writable/versions.csv) ships with the code; only its lock and leftover temp files stay local.
writable/versions.csv.lock
writable/versions.csv.tmp.*
tests/*

# Generated storage (keep directory placeholders)
writable/storage/cache/**/*.json
writable/storage/cache/*.lock
writable/storage/cache/capture-images/
writable/au.jsonl
writable/au.jsonl.tmp.*
writable/storage/sessions/sess_*
writable/storage/presence/*.json
!writable/storage/**/.gitkeep

# User uploads (keep .htaccess)
public/assets/uploads/**
!public/assets/uploads/.htaccess
!public/assets/uploads/.gitkeep

# Build tooling binaries — the Tailwind standalone CLI (~40MB) and esbuild (~10MB), both
# platform-specific; each folder's README says where to get it. The scripts, configs and
# READMEs beside them stay tracked, so the documented commands work on a clean clone.
build/*
!build/tailwind/
!build/minify/
!build/address/
build/tailwind/tailwindcss*
build/minify/esbuild*
