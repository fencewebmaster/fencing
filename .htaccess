RewriteEngine on

# /backend -> public/ (internal only; the browser URL stays /backend)
# Bare "/backend" or "/backend/" must target index.php explicitly, not a bare
# directory reference — otherwise mod_dir's trailing-slash canonicalization
# redirects to the *rewritten* target (/public/), leaking it into the URL bar.
RewriteRule ^backend/?$ public/index.php [L,QSA]
RewriteRule ^backend/(.+)$ public/$1 [L,QSA]

# Never serve app config or writable data directly.
RewriteRule ^(config\.json|writable) - [F,L,NC]

# Frontend front controller: every public URL (/planner, /checkout, /lookup/view/{slug},
# …) is routed by index.php via app/routes/frontend.php. Real files (public/assets/…)
# and the admin mounts are left alone; anything else — including unknown paths, which
# the router answers with the 404 view — goes to index.php.
RewriteCond %{REQUEST_URI} !(/backend|/public)(/|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
