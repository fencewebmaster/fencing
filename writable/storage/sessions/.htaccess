# Deny web access to PHP session files. Routed to the app's own 404 page (via index.php)
# rather than a bare 403 when mod_rewrite is available; the legacy deny directives are a
# fallback for when it isn't — the two can't safely coexist unconditionally, since Apache
# checks access-control directives (Require / Order+Deny) before per-directory rewrites,
# so an always-on deny would silently pre-empt the rewrite and this would keep showing 403
# regardless (confirmed by testing the same pattern in public/assets/uploads/.htaccess).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ ../../../index.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
