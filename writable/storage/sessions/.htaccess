# Block web access to session files. The rewrite shows the app's 404 page; the deny
# fallback is for servers without mod_rewrite (both on would always give a 403).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ ../../../index.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
